VITE_API_URL=http://localhost:8000/api

# URL de agendamento do Calendly (CTA final do diagnóstico). Sem essa variável,
# o botão "Quero analisar meu escritório" fica desabilitado em vez de abrir um
# link quebrado. Ex.: https://calendly.com/g4business/diagnostico
VITE_CALENDLY_URL=

# Nome exibido na sidebar/tela de login do admin, no <title> e nas tags de
# SEO (meta description, Open Graph, JSON-LD) do index.html.
VITE_APP_SHORT_NAME=G4
VITE_APP_NAME=G4 Business
