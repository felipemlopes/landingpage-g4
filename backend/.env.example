# Nome da marca usado no PDF, na legenda do WhatsApp e no prompt da IA —
# mantenha igual ao VITE_APP_NAME do frontend (raiz do projeto, .env).
APP_NAME=Disclose
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Gere com: php artisan jwt:secret
JWT_SECRET=

# Origens (frontend) autorizadas a chamar a API via CORS, separadas por vírgula.
# Em produção, inclua o domínio real do frontend (ex.: https://lp1.fmlsoftware.com.br).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,https://lp1.fmlsoftware.com.br

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# "database" enfileira a geração do diagnóstico (IA+PDF+WhatsApp) — requer um worker
# rodando em produção: `php artisan queue:work` (via Supervisor ou similar).
# Use "sync" apenas em desenvolvimento local sem worker (processa tudo na hora, como antes).
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Diagnóstico com IA — provider ativo: openai | gemini ────────────────────
AI_PROVIDER=openai
# G4_OPENAI_API_KEY (não "OPENAI_API_KEY"): esse nome é de propósito prefixado
# — "OPENAI_API_KEY"/"OPENAI_MODEL" colidem com variável de ambiente global
# (nível de sistema) que outras ferramentas de IA costumam definir na máquina;
# variável de sistema tem prioridade sobre o .env, então o nome genérico pode
# silenciosamente pisar na key/modelo deste projeto sem nenhum erro visível.
# Só o valor inicial: a migração que cria `ai_settings` semeia o banco com
# este valor; depois disso, a fonte de verdade em produção passa a ser
# Admin → Integrações (esta variável só serve de fallback se o banco estiver
# vazio — ver App\Models\AiSetting / OpenAIService).
G4_OPENAI_API_KEY=
G4_OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# ── WhatsApp — Evolution API ─────────────────────────────────────────────────
# Só a URL e a API Key da Evolution ficam aqui. O provider ativo (evolution |
# official) e as credenciais da API oficial (Meta) são configurados pelo admin
# na tela Integrações do painel. O nome da instância da Evolution é gerenciado
# pela aplicação (não aparece no painel).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_DEFAULT_INSTANCE=g4

# WhatsApp Cloud API oficial - Meta (usado quando WHATSAPP_PROVIDER=official)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_WABA_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
